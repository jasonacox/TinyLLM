# TinyLLM Router config — copy to router.yaml and edit.
# A request's "model" may be a pool name (chat, fast) or an exact model name (llama3:8b).
pools:
  chat:
    - {url: http://192.168.1.6:11434,  model: llama3:8b,   kind: ollama}
    - {url: http://192.168.1.77:11434, model: llama3:8b,   kind: ollama, max_inflight: 2}
  fast:
    - {url: http://192.168.1.7:11434,  model: llama3.2:3b, kind: ollama}
    - {url: http://192.168.1.5:11434,  model: llama3.2:3b, kind: ollama}
  # a vLLM or llama-cpp-python server holds one model for its lifetime: kind: openai
  # big:
  #   - {url: http://192.168.1.10:8000, model: mistralai/Mistral-7B-Instruct-v0.1, kind: openai}
health_interval: 15
request_timeout: 120
# Optional: when every healthy backend for a request is at its inflight cap, wait up to this many seconds
# for a slot to free before returning 503 (smooths bursts). 0 (default) = fail fast, no queue.
queue_timeout: 0
# Optional: keep RESIDENT kind=ollama models pinned by re-asserting keep_alive on each health sweep with a
# native /api/generate (-1 = never unload, or e.g. "30m"). Ollama's OpenAI /v1 endpoint ignores a body
# keep_alive, so this is done out-of-band; a cold model is never force-loaded, kind=openai is never pinned.
# For a full placement-based warmer across all servers, see warm.py. Omit to leave Ollama's default.
# keep_alive: -1
